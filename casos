    <div class="bot rv">
      <div>
        <span class="blk-t">El resultado esperado</span>
        <div class="res">
          <div class="rcell"><div class="v">&lt;60<em>s</em></div><div class="l">entre la cancelación y la primera oferta del hueco</div></div>
          <div class="rcell"><div class="v">24<em>/7</em></div><div class="l">agendamiento fuera de horario sin nadie disponible</div></div>
          <div class="rcell"><div class="v">0</div><div class="l">llamadas manuales de confirmación</div></div>
