<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Casos de uso — staff21x</title>
<meta name="description" content="Cuatro procesos operativos desarmados pieza por pieza: qué está roto, qué absorbe el trabajador digital, qué sigue siendo humano y cuándo no recomendamos un agente.">
<link rel="canonical" href="https://www.staff21x.com/casos.html">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6f6f7; --surface:#fff; --ink:#0a0a0b; --panel:#0b0b0d; --panel-2:#141417;
  --amber:#F59E0B; --amber-dim:rgba(245,158,11,.12); --amber-line:rgba(245,158,11,.32);
  --tx-1:#131316; --tx-2:#6a6a70; --tx-3:#9a9aa1;
  --tx-inv-1:#f4f4f5; --tx-inv-2:#a1a1aa; --tx-inv-3:#6b6b73;
  --line:rgba(0,0,0,.085); --line-mid:rgba(0,0,0,.15);
  --line-inv:rgba(255,255,255,.10); --line-inv-mid:rgba(255,255,255,.18);
  --sans:'Inter',-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --ease:cubic-bezier(.16,1,.3,1);
  --maxw:1200px; --nav-h:64px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
body{font-family:var(--sans);background:var(--bg);color:var(--tx-1);font-size:16px;line-height:1.55;letter-spacing:-.011em;overflow-x:hidden}
img{max-width:100%;display:block}
::selection{background:var(--ink);color:#fff}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:3px}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;position:relative}
.mono{font-family:var(--mono)}

.eyebrow{font-family:var(--mono);font-size:.66rem;font-weight:600;text-transform:uppercase;letter-spacing:.2em;color:var(--tx-3);display:flex;align-items:center;gap:10px;margin-bottom:20px}
.eyebrow::before{content:'';width:20px;height:1px;background:var(--amber);flex-shrink:0}
.eyebrow--inv{color:var(--tx-inv-3)}
.h-hero{font-size:clamp(2.35rem,5.6vw,4.4rem);font-weight:760;line-height:1.03;letter-spacing:-.043em;text-wrap:balance}
.h-sec{font-size:clamp(1.7rem,3.4vw,2.7rem);font-weight:730;line-height:1.1;letter-spacing:-.034em;text-wrap:balance;margin-bottom:16px}
.lead{font-size:clamp(1rem,1.3vw,1.1rem);color:var(--tx-2);line-height:1.62;max-width:60ch}
.lead--inv{color:var(--tx-inv-2)}
.amb{color:var(--amber)}

.btn{display:inline-flex;align-items:center;gap:9px;padding:14px 24px;border-radius:10px;font-size:.92rem;font-weight:600;letter-spacing:-.012em;text-decoration:none;border:1px solid transparent;transition:all .22s var(--ease);cursor:pointer;white-space:nowrap}
.btn--pri{background:var(--ink);color:#fff}
.btn--pri:hover{background:#2a2a2e;transform:translateY(-1px);box-shadow:0 10px 26px rgba(0,0,0,.16)}
.btn--ghost{background:transparent;color:var(--tx-1);border-color:var(--line-mid)}
.btn--ghost:hover{border-color:var(--ink);background:rgba(0,0,0,.03)}
.btn--inv{background:#fff;color:var(--ink)}
.btn--inv:hover{transform:translateY(-1px);box-shadow:0 10px 26px rgba(0,0,0,.4)}
.btn--ghost-inv{background:transparent;color:var(--tx-inv-1);border-color:var(--line-inv-mid)}
.btn--ghost-inv:hover{border-color:#fff;background:rgba(255,255,255,.06)}
.btn--sm{padding:9px 17px;font-size:.82rem;border-radius:8px}
.btn .ar{transition:transform .22s var(--ease)}
.btn:hover .ar{transform:translateX(3px)}

/* NAV — logo en una sola palabra */
#nav{position:fixed;inset:0 0 auto 0;height:var(--nav-h);z-index:200;display:flex;align-items:center;padding:0 28px;background:rgba(246,246,247,.82);backdrop-filter:blur(20px) saturate(1.6);border-bottom:1px solid transparent;transition:border-color .3s,background .3s}
#nav.on{border-bottom-color:var(--line);background:rgba(246,246,247,.95)}
.nav-in{max-width:var(--maxw);margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{text-decoration:none;font-size:1.16rem;font-weight:800;letter-spacing:-.055em;color:var(--ink);display:inline-flex;align-items:center;gap:8px}
.logo::before{content:'';width:7px;height:7px;border-radius:2px;background:var(--amber);flex-shrink:0}
.logo--inv{color:#fff}
.nav-links{display:flex;gap:26px;list-style:none}
.nav-links a{font-size:.845rem;font-weight:500;color:var(--tx-2);text-decoration:none;transition:color .18s}
.nav-links a:hover{color:var(--tx-1)}
.nav-right{display:flex;align-items:center;gap:10px}

.sec{padding:clamp(64px,8vw,112px) 0;position:relative}
.sec--dark{background:var(--panel);color:var(--tx-inv-1)}
.sec--dark .h-sec{color:#fff}
.sec--white{background:var(--surface)}
.sec-head{margin-bottom:clamp(36px,4.6vw,60px);max-width:70ch}
.sec-num{font-family:var(--mono);font-size:.66rem;font-weight:600;letter-spacing:.16em;color:var(--tx-3);display:block;margin-bottom:12px}
.sec--dark .sec-num{color:var(--tx-inv-3)}

.rv{opacity:0;transform:translateY(18px);transition:opacity .75s var(--ease),transform .75s var(--ease)}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}

footer{background:var(--panel);color:var(--tx-inv-2);padding:56px 0 30px}
.f-grid{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;gap:36px;margin-bottom:40px}
.f-h{font-family:var(--mono);font-size:.63rem;text-transform:uppercase;letter-spacing:.18em;color:var(--tx-inv-3);margin-bottom:14px}
.f-list{list-style:none;display:flex;flex-direction:column;gap:9px}
.f-list a{font-size:.87rem;color:var(--tx-inv-2);text-decoration:none;transition:color .18s}
.f-list a:hover{color:#fff}
.f-bot{border-top:1px solid var(--line-inv);padding-top:22px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:.77rem;color:var(--tx-inv-3)}

@media(max-width:960px){ .f-grid{grid-template-columns:1fr 1fr;gap:30px} }
@media(max-width:900px){ .nav-right .btn--ghost{display:none} }
@media(max-width:760px){
  .nav-links{display:none}
  #nav{padding:0 18px}
  .wrap{padding:0 20px}
  .f-grid{grid-template-columns:1fr}
}
.chero{padding:calc(var(--nav-h) + clamp(44px,6vw,76px)) 0 clamp(30px,4vw,48px)}
.chero h1{margin-bottom:20px;max-width:18ch;font-size:clamp(2.1rem,4.8vw,3.6rem)}
.disc{margin-top:26px;background:var(--surface);border:1px solid var(--line);border-left:2px solid var(--amber);border-radius:12px;padding:18px 22px;font-size:.85rem;color:var(--tx-2);line-height:1.6;max-width:74ch}
.disc b{color:var(--tx-1);font-weight:600}

.idx{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.idx a{background:var(--bg);padding:20px 20px 20px 0;text-decoration:none;display:block;transition:background .2s}
.idx a:not(:first-child){padding-left:20px}
.idx a:hover{background:var(--surface)}
.idx .k{font-family:var(--mono);font-size:.63rem;font-weight:600;letter-spacing:.14em;color:var(--amber);display:block;margin-bottom:8px}
.idx .t{font-size:.92rem;font-weight:620;letter-spacing:-.02em;color:var(--tx-1);line-height:1.3}

.cs{padding:clamp(56px,7vw,92px) 0;border-top:1px solid var(--line);scroll-margin-top:80px}
.cs:nth-child(even){background:var(--surface)}
.cs-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.cs-id{font-family:var(--mono);font-size:.7rem;font-weight:600;letter-spacing:.15em;color:#fff;background:var(--ink);padding:6px 12px;border-radius:7px}
.cs-tag{font-size:.73rem;color:var(--tx-2);border:1px solid var(--line-mid);border-radius:20px;padding:5px 12px}
.cs h2{font-size:clamp(1.5rem,3.1vw,2.3rem);font-weight:730;letter-spacing:-.034em;line-height:1.12;margin-bottom:32px;text-wrap:balance;max-width:20ch}

.blk-t{font-family:var(--mono);font-size:.63rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--tx-3);display:block;margin-bottom:14px}
.blk-t--amb{color:var(--amber)}

.top{display:grid;grid-template-columns:1fr 1.08fr;gap:clamp(22px,3.4vw,44px);margin-bottom:clamp(30px,3.6vw,46px);align-items:start}
.top p{font-size:.95rem;color:var(--tx-2);line-height:1.62}
.top p b{color:var(--tx-1);font-weight:600}
.find{background:var(--ink);border-radius:18px;padding:clamp(24px,2.8vw,32px)}
.find .blk-t{color:var(--amber)}
.find p{font-size:1rem;color:#d9d9dd;line-height:1.6}
.find p+p{margin-top:12px}
.top .find p b{color:var(--amber);font-weight:600}

/* descomposición: 3 columnas de chips */
.dec{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden;margin-bottom:clamp(26px,3.2vw,40px)}
.dec-c{background:var(--bg);padding:22px}
.cs:nth-child(even) .dec-c{background:var(--surface)}
.dec-h{display:flex;align-items:center;gap:8px;font-size:.83rem;font-weight:660;letter-spacing:-.016em;margin-bottom:14px}
.dec-h .pip{width:8px;height:8px;border-radius:2px;flex-shrink:0}
.dec-c.rep .pip{background:var(--amber)}
.dec-c.cri .pip{background:var(--ink)}
.dec-c.sob .pip{background:var(--line-mid)}
.dec-c ul{list-style:none}
.dec-c li{font-size:.85rem;color:var(--tx-2);line-height:1.45;padding:8px 0;border-bottom:1px solid var(--line)}
.dec-c li:last-child{border-bottom:none}
.dec-c.sob li{color:var(--tx-3);text-decoration:line-through;text-decoration-color:var(--line-mid)}

/* reparto */
.rep-wrap{margin-bottom:clamp(26px,3.2vw,40px)}
.bar{display:flex;height:12px;border-radius:7px;overflow:hidden;background:var(--line);margin-bottom:10px}
.bar i{display:block;height:100%}
.bar .a{background:var(--amber)}
.bar .h{background:var(--ink);opacity:.24}
.bar-l{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.65rem;color:var(--tx-3);letter-spacing:.04em;margin-bottom:20px}
.dual{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.dbox{border:1px solid var(--line);border-radius:14px;padding:20px;background:var(--bg)}
.cs:nth-child(even) .dbox{background:var(--surface)}
.dbox.robot{border-color:var(--amber-line);background:linear-gradient(180deg,rgba(245,158,11,.05),transparent 55%)}
.dbox h4{font-size:.85rem;font-weight:660;margin-bottom:12px;letter-spacing:-.014em}
.dbox ul{list-style:none}
.dbox li{padding:8px 0;border-bottom:1px solid var(--line);font-size:.86rem;color:var(--tx-2);line-height:1.45}
.dbox li:last-child{border-bottom:none}

/* resultado + no */
.bot{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(20px,3vw,36px);align-items:start}
.res{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.rcell{background:var(--bg);padding:20px}
.cs:nth-child(even) .rcell{background:var(--surface)}
.rcell .v{font-size:clamp(1.35rem,2.3vw,1.8rem);font-weight:750;letter-spacing:-.04em;line-height:1}
.rcell .v em{font-style:normal;color:var(--amber);font-size:.55em;margin-left:1px}
.rcell .l{font-size:.79rem;color:var(--tx-2);margin-top:9px;line-height:1.42}
.nono{border:1px solid var(--line-mid);border-radius:14px;padding:20px;background:rgba(0,0,0,.025)}
.nono ul{list-style:none}
.nono li{padding:8px 0 8px 18px;position:relative;font-size:.85rem;color:var(--tx-2);line-height:1.5}
.nono li::before{content:'—';position:absolute;left:0;color:var(--tx-3)}
.nono li b{color:var(--tx-1);font-weight:600}
.fine{font-family:var(--mono);font-size:.66rem;color:var(--tx-3);line-height:1.6;margin-top:14px}

.cta{background:var(--ink);border-radius:24px;padding:clamp(38px,5vw,64px);text-align:center;position:relative;overflow:hidden}
.cta::before{content:'';position:absolute;top:-150px;left:50%;transform:translateX(-50%);width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.17),transparent 68%)}
.cta > *{position:relative}
.cta h2{font-size:clamp(1.6rem,3.2vw,2.4rem);font-weight:730;letter-spacing:-.036em;line-height:1.1;color:#fff;margin-bottom:16px;text-wrap:balance}
.cta p{color:var(--tx-inv-2);font-size:1rem;max-width:52ch;margin:0 auto 28px;line-height:1.6}
.cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.cta-fine{margin-top:22px;font-family:var(--mono);font-size:.67rem;color:var(--tx-inv-3);letter-spacing:.04em}

@media(max-width:960px){
  .idx{grid-template-columns:1fr 1fr}
  .top,.bot{grid-template-columns:1fr}
  .dec{grid-template-columns:1fr}
}
@media(max-width:700px){
  .idx{grid-template-columns:1fr} .idx a:not(:first-child){padding-left:0}
  .dual,.res{grid-template-columns:1fr}
}

.cs h2 .wm{padding-bottom:.16em;margin-bottom:-.16em}
.find{transition:box-shadow .35s}
.find:hover{box-shadow:0 20px 50px rgba(0,0,0,.22)}
.dbox,.dec-c,.nono,.rcell{transition:border-color .28s,background .28s}
.dbox.robot:hover{border-color:var(--amber);box-shadow:0 12px 34px rgba(245,158,11,.13)}
.dbox li,.dec-c li{transition:color .2s,padding-left .28s var(--ease)}
.dbox li:hover,.dec-c li:hover{color:var(--tx-1);padding-left:6px}
.idx a .t{transition:color .2s}
.idx a:hover .t{color:var(--amber)}

/* ============ EFECTOS ============ */
/* 1 · revelado de texto por palabra */
.wm{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.14em;margin-bottom:-.14em}
.wi{display:inline-block;transform:translateY(110%);opacity:0;
    transition:transform .85s var(--ease),opacity .6s var(--ease)}
.rv.in .wi,.in .wi{transform:none;opacity:1}
@media (prefers-reduced-motion:reduce){.wi{transform:none;opacity:1;transition:none}}

/* 2 · nav con subrayado animado */
.nav-links a{position:relative;padding-bottom:3px}
.nav-links a::after{content:'';position:absolute;left:0;right:0;bottom:0;height:1.5px;background:var(--amber);
  transform:scaleX(0);transform-origin:right;transition:transform .38s var(--ease)}
.nav-links a:hover::after{transform:scaleX(1);transform-origin:left}

/* 3 · camino: línea que se llena */
.road::before{background:var(--line-mid)}
.road-fill{position:absolute;left:0;top:23px;height:2px;background:var(--amber);width:0;z-index:1;
  transition:width 1.4s cubic-bezier(.22,1,.36,1);box-shadow:0 0 12px rgba(245,158,11,.55)}
.stop-n{transition:background .5s var(--ease),border-color .5s var(--ease),color .5s var(--ease),transform .5s var(--ease)}
.stop.on .stop-n{background:var(--amber);border-color:var(--amber);color:#000;transform:scale(1.06)}
.stop .give{transition:border-color .3s,box-shadow .3s}
.stop:hover .give{border-color:var(--amber-line);box-shadow:0 6px 20px rgba(245,158,11,.12)}

/* 4 · tarjetas de área desplegables */
.area{cursor:pointer;position:relative}
.area-more{margin-top:auto;padding-top:16px;background:none;border:0;border-top:1px solid var(--line);
  display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;cursor:pointer;
  font-family:var(--sans);font-size:.79rem;font-weight:620;color:var(--tx-2);letter-spacing:-.012em;
  transition:color .22s;text-align:left}
.area:hover .area-more{color:var(--tx-1)}
.pm{position:relative;width:16px;height:16px;flex-shrink:0}
.pm::before,.pm::after{content:'';position:absolute;background:var(--amber);border-radius:1px;
  transition:transform .38s var(--ease),opacity .3s}
.pm::before{left:0;top:7px;width:16px;height:2px}
.pm::after{left:7px;top:0;width:2px;height:16px}
.area.open .pm::after{transform:rotate(90deg);opacity:0}
.area-panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s var(--ease)}
.area.open .area-panel{grid-template-rows:1fr}
.area-panel > div{overflow:hidden}
.area-panel p{font-size:.83rem;color:var(--tx-2);line-height:1.6;padding-top:14px;
  opacity:0;transform:translateY(6px);transition:opacity .45s .12s var(--ease),transform .45s .12s var(--ease)}
.area.open .area-panel p{opacity:1;transform:none}

/* 5 · brillo que sigue el cursor en superficies oscuras */
.glow{position:relative;isolation:isolate}
.glow::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;
  transition:opacity .35s;z-index:0;
  background:radial-gradient(320px circle at var(--mx,50%) var(--my,50%),rgba(245,158,11,.14),transparent 62%)}
.glow:hover::after{opacity:1}

/* 6 · marquesina */
.band{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--surface);
  overflow:hidden;position:relative;padding:15px 0}
.band::before,.band::after{content:'';position:absolute;top:0;bottom:0;width:140px;z-index:2;pointer-events:none}
.band::before{left:0;background:linear-gradient(90deg,var(--surface),transparent)}
.band::after{right:0;background:linear-gradient(270deg,var(--surface),transparent)}
.band-row{display:flex;gap:12px;white-space:nowrap;width:max-content;animation:slide 42s linear infinite}
.band:hover .band-row{animation-play-state:paused}
@keyframes slide{to{transform:translateX(-50%)}}
.chip{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:.72rem;
  color:var(--tx-2);border:1px solid var(--line);border-radius:999px;padding:7px 15px;background:var(--bg);flex-shrink:0}
.chip::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--amber);flex-shrink:0}
@media (prefers-reduced-motion:reduce){.band-row{animation:none}}

/* 7 · números que cuentan */
.num{font-variant-numeric:tabular-nums}

/* 8 · imán en los botones */
.btn{will-change:transform}
.case,.area,.line-c{will-change:transform}

/* 9 · barras de reparto que crecen */
.split i,.bar i{width:0;transition:width 1.1s .15s cubic-bezier(.22,1,.36,1)}
.rv.in .split i,.rv.in .bar i{width:var(--w)}
</style></head>
