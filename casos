<script>
(function(){
  var RM = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* --- nav --- */
  var nav=document.getElementById('nav');
  var onScroll=function(){ nav.classList.toggle('on', window.scrollY>10); };
  onScroll(); window.addEventListener('scroll',onScroll,{passive:true});

  /* --- 1 · partir títulos en palabras --- */
  function split(el){
    if(el.dataset.sp) return; el.dataset.sp='1';
    (function walk(node){
      Array.prototype.slice.call(node.childNodes).forEach(function(n){
        if(n.nodeType===3){
          if(!n.textContent.trim()){ return; }
          var frag=document.createDocumentFragment();
          n.textContent.split(/(\s+)/).forEach(function(t){
            if(!t) return;
            if(/^\s+$/.test(t)){ frag.appendChild(document.createTextNode(' ')); return; }
            var o=document.createElement('span'); o.className='wm';
            var i=document.createElement('span'); i.className='wi'; i.textContent=t;
            o.appendChild(i); frag.appendChild(o);
          });
          node.replaceChild(frag,n);
        } else if(n.nodeType===1 && n.tagName!=='BR'){ walk(n); }
      });
    })(el);
    Array.prototype.slice.call(el.querySelectorAll('.wi')).forEach(function(w,i){
      w.style.transitionDelay=(Math.min(i,18)*0.038)+'s';
    });
  }
  if(!RM){
    document.querySelectorAll('.h-hero, .h-sec, .cs h2, .cta h2').forEach(split);
  }

  /* --- 9 · anchos de barras diferidos --- */
  document.querySelectorAll('.split i, .bar i').forEach(function(b){
    if(b.style.width){ b.style.setProperty('--w', b.style.width); b.style.width=''; }
  });

  /* --- reveal general --- */
  var els=document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window)){
    els.forEach(function(e){e.classList.add('in')});
  } else {
    var io=new IntersectionObserver(function(en){
      en.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add('in'); io.unobserve(x.target); } });
    },{rootMargin:'0px 0px -8% 0px',threshold:.05});
    els.forEach(function(e){io.observe(e)});
  }

  /* --- 5 · brillo con el cursor --- */
  document.querySelectorAll('.glow').forEach(function(el){
    el.addEventListener('mousemove',function(e){
      var r=el.getBoundingClientRect();
      el.style.setProperty('--mx',(e.clientX-r.left)+'px');
      el.style.setProperty('--my',(e.clientY-r.top)+'px');
    });
  });

  /* --- 7 · contadores --- */
  function countUp(el){
    var end=parseFloat(el.dataset.count), dec=(el.dataset.count.split('.')[1]||'').length;
    var pre=el.dataset.pre||'', t0=null, dur=1200;
    function step(ts){
      if(!t0) t0=ts;
      var p=Math.min(1,(ts-t0)/dur), e=1-Math.pow(1-p,3);
      el.firstChild.textContent = pre + (end*e).toFixed(dec);
      if(p<1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  var nums=document.querySelectorAll('[data-count]');
  if(nums.length && 'IntersectionObserver' in window && !RM){
    var no=new IntersectionObserver(function(en){
      en.forEach(function(x){ if(x.isIntersecting){ countUp(x.target); no.unobserve(x.target); } });
    },{threshold:.6});
    nums.forEach(function(n){ n.firstChild.textContent=(n.dataset.pre||'')+'0'; no.observe(n); });
  }

  /* --- 8 · imán en botones --- */
  if(!RM && window.matchMedia('(pointer:fine)').matches){
    document.querySelectorAll('.btn').forEach(function(b){
      b.addEventListener('mousemove',function(e){
        var r=b.getBoundingClientRect();
        b.style.transform='translate('+((e.clientX-r.left-r.width/2)*0.10)+'px,'+((e.clientY-r.top-r.height/2)*0.16-1)+'px)';
      });
      b.addEventListener('mouseleave',function(){ b.style.transform=''; });
    });
  }
})();
</script>
</body>
</html>
