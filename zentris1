var sectionsForStacking = document.querySelectorAll('section');
window.addEventListener('scroll', function() {
    if(reduce) return; // Respeta la preferencia de movimiento reducido
    sectionsForStacking.forEach(function(sec, i) {
        var rect = sec.getBoundingClientRect();
        // Si la sección está subiendo por encima de la pantalla y no es la última
        if (rect.top < 0 && i < sectionsForStacking.length - 1) {
            // Calcula un escalado mínimo de 0.95 y un oscurecimiento
            var depth = Math.abs(rect.top) / window.innerHeight;
            var scale = Math.max(0.95, 1 - (depth * 0.05));
            var brightness = Math.max(0.6, 1 - (depth * 0.4));
            
            sec.style.transform = 'scale(' + scale + ') translateY(' + (depth * 20) + 'px)';
            sec.style.filter = 'brightness(' + brightness + ')';
            sec.style.transformOrigin = 'top center';
            sec.style.zIndex = i;
            sec.style.position = 'relative';
        } else {
            sec.style.transform = 'none';
            sec.style.filter = 'none';
            sec.style.zIndex = i;
        }
    });
}, {passive: true});

})();
</script>
</body>
