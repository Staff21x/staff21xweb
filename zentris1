<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zentris Fintech · El respaldo técnico de la confianza en el negocio financiero digital</title>
<meta name="description" content="Gestión continua de exposición, validación ofensiva permanente y reporting regulatorio multijurisdicción para entidades financieras supervisadas por BCRA, ANCI, CMF, SBS y Superintendencia Financiera de Colombia.">
<style>
/* ==========================================================================
   1 · SISTEMA DE DISEÑO
   Blanco y negro heredado de la web original + ámbar de marca (#F59E0B),
   reservado exclusivamente para el isotipo.
   ========================================================================== */
:root{
  --bg:#f5f5f7;
  --white:#ffffff;
  --ink:#000000;

  --amber:#F59E0B;

  --line:rgba(0,0,0,.08);
  --line-mid:rgba(0,0,0,.14);
  --line-strong:rgba(0,0,0,.28);

  --tx-1:#1d1d1f;
  --tx-2:#86868b;
  --tx-3:#6e6e73;

  --sans:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Helvetica,Arial,sans-serif;
  --mono:"SF Mono","Fira Code",Monaco,Consolas,monospace;

  --ease:cubic-bezier(.16,1,.3,1);
  --ease-soft:cubic-bezier(.4,0,.2,1);

  --maxw:1080px;
  --nav-h:60px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

html{
  font-family:var(--sans);
  background:var(--bg);
  color:var(--tx-1);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  scroll-behavior:smooth;
}
body{line-height:1.45;font-weight:400;letter-spacing:-.015em;background:var(--bg)}
img{max-width:100%;display:block}
::selection{background:#000;color:#fff}
:focus-visible{outline:2px solid #000;outline-offset:3px;border-radius:4px}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 20px;position:relative}
.wrap--wide{max-width:1240px}

/* ---------- Tipografía ---------- */
.eyebrow{
  font-family:var(--mono);font-size:.68rem;font-weight:600;
  text-transform:uppercase;letter-spacing:.18em;color:var(--tx-2);
  display:block;margin-bottom:16px;
}
.h-sec{font-size:clamp(1.55rem,3.1vw,2.5rem);font-weight:700;line-height:1.14;letter-spacing:-.028em;margin-bottom:16px}
h1,h2,h3,.h-sec{overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}
.split .w{max-width:100%}
.lead{font-size:clamp(.98rem,1.4vw,1.12rem);color:var(--tx-2);line-height:1.5;max-width:680px}
.lead--c{margin-left:auto;margin-right:auto;text-align:center}

/* ==========================================================================
   2 · ISOTIPO ÁMBAR
   ========================================================================== */
.mark-z{
  background:var(--amber);
  color:#000;
  display:flex;align-items:center;justify-content:center;
  font-weight:800;line-height:1;
  font-family:var(--sans);
  flex-shrink:0;
}
.mark-z--sm{width:28px;height:28px;border-radius:8px;font-size:.92rem;letter-spacing:-.02em}
.mark-z--xl{
  width:76px;height:76px;border-radius:20px;font-size:2.4rem;letter-spacing:-.04em;
  position:relative;margin:0 auto;
  box-shadow:0 10px 34px rgba(245,158,11,.30);
}
/* halos concéntricos del isotipo original */
.mark-z--xl::before,
.mark-z--xl::after{
  content:'';position:absolute;border-radius:26px;pointer-events:none;
  border:1px solid rgba(245,158,11,.34);
}
.mark-z--xl::before{inset:-12px;animation:halo 3.6s var(--ease-soft) infinite}
.mark-z--xl::after{inset:-24px;border-radius:32px;border-color:rgba(245,158,11,.18);animation:halo 3.6s var(--ease-soft) .5s infinite}
@keyframes halo{
  0%{opacity:.9;transform:scale(.94)}
  60%{opacity:0;transform:scale(1.06)}
  100%{opacity:0;transform:scale(1.06)}
}

/* ==========================================================================
   3 · EFECTOS DE ENTRADA
   ========================================================================== */

/* 3.1 — Revelado de texto palabra por palabra, desde una máscara */
.w{display:inline-block;overflow:hidden;vertical-align:bottom}
.w > i{
  display:inline-block;font-style:normal;
  transform:translateY(105%);
  transition:transform .9s var(--ease);
}
.split.is-in .w > i{transform:none}
.split.is-done .w{overflow:visible}

/* 3.2 — Barrido de resaltado */
/* El resaltado va como fondo, no como caja: así la frase puede partirse
   en dos líneas sin romper el efecto ni forzar desbordes en el celular. */
.hl{
  display:inline;padding:.02em .12em;margin:0 -.12em;
  background-image:linear-gradient(#000,#000);
  background-repeat:no-repeat;background-position:left center;background-size:0% 100%;
  -webkit-box-decoration-break:clone;box-decoration-break:clone;
  transition:background-size .6s var(--ease),color .3s var(--ease) .26s;
}
.hl.lit{background-size:100% 100%;color:#fff}

/* Elementos con estilo propio dentro de un titular partido en palabras:
   entran con una atenuación simple para no encerrarlos en una caja atómica. */
.wx{opacity:0;transition:opacity .75s var(--ease) .2s}
.split.is-in .wx{opacity:1}

/* 3.3 — Aparición con desplazamiento */
.up{opacity:0;transform:translateY(24px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.up.is-in{opacity:1;transform:none}

.seq > *{opacity:0;transform:translateY(24px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.seq.is-in > *{opacity:1;transform:none}
.seq.is-in > *:nth-child(1){transition-delay:0s}
.seq.is-in > *:nth-child(2){transition-delay:.08s}
.seq.is-in > *:nth-child(3){transition-delay:.16s}
.seq.is-in > *:nth-child(4){transition-delay:.24s}
.seq.is-in > *:nth-child(5){transition-delay:.32s}
.seq.is-in > *:nth-child(6){transition-delay:.40s}
.seq.is-in > *:nth-child(7){transition-delay:.48s}
.seq.is-in > *:nth-child(8){transition-delay:.56s}
.seq.is-in > *:nth-child(9){transition-delay:.64s}
.seq.is-in > *:nth-child(10){transition-delay:.72s}

/* 3.4 — Barrido de imagen: la captura se descubre de abajo hacia arriba.
   El recorte se aplica al marco, pero quien lo dispara es el contenedor:
   un elemento totalmente recortado tiene área cero y el detector de scroll
   nunca lo daría por visible. */
.shot{position:relative}
.shot .frame{clip-path:inset(0 0 100% 0);transition:clip-path 1.05s var(--ease)}
.shot.is-in .frame{clip-path:inset(0 0 0 0)}

/* 3.5 — Disgregación en bits
   La captura se arma desde partículas cuadradas al entrar y vuelve a
   dispersarse al salir. El movimiento lo manda la posición de scroll,
   no un temporizador: si te detenés a medio camino, queda a medio armar. */
.px-holder{position:relative;line-height:0;font-size:0}
.px-holder img{opacity:0;transition:opacity .3s linear}
.px-holder.px-off img{opacity:1}
.px-canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.px-holder.px-off .px-canvas{display:none}

/* 3.6 — Titulares que se materializan carácter a carácter */
/* Cada palabra es una unidad indivisible; los caracteres se animan dentro.
   Sin esto el navegador puede cortar entre dos letras cualesquiera. */
.bits .wd{display:inline-block;white-space:nowrap;max-width:100%}
.bits .sp,.split .sp{display:inline;white-space:pre}
.bits .ch{
  display:inline-block;
  opacity:0;filter:blur(3px);
  transform:translate(var(--dx),var(--dy)) scale(.35);
  transition:opacity .7s var(--ease),transform .8s var(--ease),filter .7s var(--ease);
  transition-delay:var(--d);
}
.bits.is-in .ch{opacity:1;filter:none;transform:none}

/* 3.7 — Barra de progreso de lectura */
#progress{position:fixed;top:0;left:0;height:2px;width:0;background:var(--amber);z-index:2000;transition:width .1s linear}

/* ==========================================================================
   4 · HEADER
   ========================================================================== */
header{
  position:fixed;top:0;left:0;width:100%;z-index:1000;
  background:rgba(255,255,255,.78);
  backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);
  border-bottom:1px solid var(--line);
  transition:transform .45s var(--ease),background .3s ease;
}
header.hidden{transform:translateY(-101%)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;height:var(--nav-h);padding:0 20px;max-width:var(--maxw);margin:0 auto}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--tx-1)}
.brand b{font-size:1rem;font-weight:700;letter-spacing:-.02em}
.brand small{font-family:var(--mono);font-size:.58rem;color:var(--tx-2);letter-spacing:.08em}
.nav-links{display:flex;gap:24px;list-style:none}
.nav-links a{
  color:var(--tx-2);text-decoration:none;font-size:.8rem;position:relative;padding:5px 0;
  transition:color .25s var(--ease-soft);
}
.nav-links a::after{content:'';position:absolute;left:0;bottom:0;height:1.5px;width:0;background:#000;transition:width .35s var(--ease)}
.nav-links a:hover,.nav-links a.on{color:var(--tx-1)}
.nav-links a:hover::after,.nav-links a.on::after{width:100%}

/* ---------- Botones ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  border-radius:980px;font-size:.85rem;font-weight:500;padding:10px 22px;
  text-decoration:none;cursor:pointer;border:1px solid transparent;
  transition:background .3s var(--ease-soft),color .3s var(--ease-soft),border-color .3s var(--ease-soft),transform .3s var(--ease);
}
.btn:hover{transform:translateY(-2px)}
.btn .arw{display:inline-block;transition:transform .4s var(--ease)}
.btn:hover .arw{transform:translateX(5px)}
.btn-solid{background:#000;color:#fff}
.btn-solid:hover{background:#2d2d2d}
.btn-ghost{background:rgba(0,0,0,.05);color:var(--tx-1);border-color:var(--line)}
.btn-ghost:hover{background:rgba(0,0,0,.09);border-color:var(--line-mid)}
.btn-invert{background:#fff;color:#000}
.btn-invert:hover{background:#e8e8ed}
.btn-outline-l{background:transparent;color:#fff;border-color:rgba(255,255,255,.28)}
.btn-outline-l:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.5)}

/* ==========================================================================
   5 · HERO
   ========================================================================== */
.hero{padding:calc(var(--nav-h) + 64px) 0 56px;text-align:center}
.hero .mark-z--xl{margin-bottom:26px}
.hero-tag{
  display:inline-block;font-family:var(--mono);font-size:.66rem;font-weight:600;
  letter-spacing:.16em;text-transform:uppercase;color:var(--tx-3);
  padding:6px 15px;border:1px solid var(--line-mid);border-radius:980px;
  background:rgba(255,255,255,.7);margin-bottom:24px;
}
.hero h1{font-size:clamp(1.72rem,4vw,3rem);font-weight:700;line-height:1.16;letter-spacing:-.032em;max-width:950px;margin:0 auto 22px}
.hero h1 .dim{color:var(--tx-2)}
.hero-sub{font-size:clamp(.98rem,1.4vw,1.12rem);color:var(--tx-2);max-width:660px;margin:0 auto 32px;line-height:1.5}
.hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:46px}

/* ---------- Marco de producto ---------- */
.frame{
  border-radius:18px;background:#0a0a0c;overflow:hidden;
  border:1px solid rgba(255,255,255,.14);
  box-shadow:0 30px 70px rgba(0,0,0,.26);
}
.frame img{width:100%;height:auto;display:block}
.frame-bar{height:38px;background:#141416;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:space-between;padding:0 14px;gap:12px}
.dots{display:flex;gap:6px;flex-shrink:0}
.dots i{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.2);display:block}
.frame-t{font-family:var(--mono);font-size:.64rem;color:rgba(255,255,255,.45);letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.frame-s{font-family:var(--mono);font-size:.6rem;color:rgba(255,255,255,.55);display:flex;align-items:center;gap:6px;flex-shrink:0}
.frame-s i{width:6px;height:6px;border-radius:50%;background:#fff;display:block;animation:blink 2s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.cap{
  font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;
  color:var(--tx-2);margin-top:13px;display:flex;align-items:center;gap:9px;
}
.cap::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--amber);flex-shrink:0}

/* ==========================================================================
   6 · MÉTRICAS
   ========================================================================== */
.metrics{padding:46px 0;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.metrics-g{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px;text-align:center}
.m-v{font-family:var(--mono);font-size:clamp(1.9rem,3.2vw,2.5rem);font-weight:700;letter-spacing:-.045em;margin-bottom:5px}
.m-l{font-size:.66rem;color:var(--tx-2);text-transform:uppercase;letter-spacing:.13em;font-weight:600}

/* ==========================================================================
   7 · ESTRUCTURA DE SECCIONES
   ========================================================================== */

section {
    position: relative;
    background: var(--bg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transition: transform 0.1s linear, filter 0.1s linear;
}
.sec--w { background: #fff; }

section[id]{scroll-margin-top:var(--nav-h)}
.sec{padding:84px 0}
.sec--w{background:#fff}
.sec--o{background:var(--bg)}
.head{max-width:780px;margin-bottom:42px}
.head--c{margin-left:auto;margin-right:auto;text-align:center}

.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}

.box{
  padding:28px;background:#fff;border-radius:18px;border:1px solid var(--line);
  transition:border-color .4s var(--ease),box-shadow .4s var(--ease),transform .4s var(--ease);
}
.box:hover{border-color:var(--line-strong);box-shadow:0 16px 40px rgba(0,0,0,.07);transform:translateY(-3px)}
.box .n{font-family:var(--mono);font-size:.7rem;color:var(--tx-3);font-weight:600;margin-bottom:12px;letter-spacing:.1em}
.box h3{font-size:1.06rem;font-weight:600;margin-bottom:9px;letter-spacing:-.018em}
.box p{color:var(--tx-2);font-size:.88rem;line-height:1.55}
.box strong{color:var(--tx-1);font-weight:600}
.box--dark{background:#000;color:#fff;border-color:#000}
.box--dark:hover{border-color:#000;box-shadow:0 16px 40px rgba(0,0,0,.22)}
.box--dark h3{color:#fff}
.box--dark p{color:rgba(255,255,255,.6)}
.box--dark .n{color:rgba(255,255,255,.5)}
.box--dark strong{color:#fff}

.alist{list-style:none;display:flex;flex-direction:column;gap:20px}
.alist li{display:flex;gap:13px;font-size:.92rem;line-height:1.55;color:var(--tx-2)}
.alist li::before{content:'→';font-family:var(--mono);color:var(--tx-1);flex-shrink:0;font-size:.88rem;line-height:1.65}
.alist strong{color:var(--tx-1);font-weight:600}

.note{
  display:flex;gap:16px;align-items:center;flex-wrap:wrap;
  padding:22px 26px;background:#fff;border:1px solid var(--line);border-radius:16px;
  font-size:.9rem;color:var(--tx-2);line-height:1.55;
}
.note strong{color:var(--tx-1);font-weight:600}
.chip{
  font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  padding:6px 12px;border-radius:6px;background:#000;color:#fff;flex-shrink:0;display:inline-block;
}
.chip--o{background:rgba(0,0,0,.05);color:var(--tx-1);border:1px solid var(--line-mid)}
.chip--l{background:#fff;color:#000}

.sticky-col{position:sticky;top:calc(var(--nav-h) + 30px)}

/* ==========================================================================
   8 · ESCENA FIJADA · las tres capas
   ========================================================================== */
.pin{position:relative}
.pin-stage{position:sticky;top:0;height:100vh;display:flex;align-items:center;overflow:hidden}
.pin-in{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 20px;display:grid;grid-template-columns:340px 1fr;gap:60px;align-items:center}

.stack{display:flex;flex-direction:column;gap:12px}
.layer{
  border:1px solid var(--line-mid);border-radius:14px;padding:18px 20px;background:#fff;
  transition:background .55s var(--ease),border-color .55s var(--ease),transform .55s var(--ease);
  position:relative;overflow:hidden;cursor:pointer;
}
.layer .lk{font-family:var(--mono);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--tx-2);transition:color .5s var(--ease)}
.layer .ln{font-size:.98rem;font-weight:600;margin-top:5px;transition:color .5s var(--ease)}
.layer::after{
  content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--amber);
  transform:scaleY(0);transform-origin:top;transition:transform .55s var(--ease);
}
.layer.on{background:#000;border-color:#000;transform:translateX(10px)}
.layer.on .lk{color:rgba(255,255,255,.55)}
.layer.on .ln{color:#fff}
.layer.on::after{transform:scaleY(1)}

.pin-panes{position:relative;min-height:230px}
.pin-pane{
  position:absolute;inset:0;opacity:0;transform:translateY(22px);
  transition:opacity .5s var(--ease),transform .5s var(--ease);pointer-events:none;
}
.pin-pane.on{opacity:1;transform:none;pointer-events:auto}
.pin-pane h3{font-size:clamp(1.6rem,3.2vw,2.3rem);font-weight:700;letter-spacing:-.03em;margin-bottom:16px}
.pin-pane p{font-size:clamp(1rem,1.5vw,1.14rem);color:var(--tx-2);line-height:1.6;max-width:520px}
.pin-pane p strong{color:var(--tx-1);font-weight:600}
.pin-rail{margin-top:34px;height:2px;background:var(--line-mid);border-radius:2px;max-width:420px;position:relative}
.pin-rail i{position:absolute;inset:0 auto 0 0;width:0;background:#000;border-radius:2px;display:block;transition:width .15s linear}

/* ==========================================================================
   9 · INTEL Y ALCANCE
   ========================================================================== */
.intel{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.1);border-radius:16px;overflow:hidden}
.intel-c{background:#000;padding:24px 20px}
.intel-c .n{font-family:var(--mono);font-size:2rem;font-weight:700;color:#fff;letter-spacing:-.04em;line-height:1}
.intel-c .l{font-size:.6rem;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.12em;margin-top:9px;line-height:1.45}
.scopes{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}
.scope{padding:18px;background:#fff;border:1px solid var(--line);border-radius:14px;transition:border-color .35s var(--ease)}
.scope:hover{border-color:var(--line-strong)}
.scope .k{font-family:var(--mono);font-size:1.1rem;font-weight:700;letter-spacing:-.02em}
.scope .v{font-size:.62rem;color:var(--tx-2);text-transform:uppercase;letter-spacing:.11em;margin-top:7px;line-height:1.45}

/* ==========================================================================
   10 · COMPARATIVA
   ========================================================================== */
.vs{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.vs-c{padding:32px;border-radius:20px;border:1px solid var(--line);background:#fff}
.vs-c--hi{background:#000;border-color:#000;color:#fff}
.vs-r{display:grid;grid-template-columns:132px 1fr;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);font-size:.86rem;line-height:1.5}
.vs-c--hi .vs-r{border-color:rgba(255,255,255,.12)}
.vs-r:last-child{border-bottom:none}
.vs-r b{font-weight:600}
.vs-r span{color:var(--tx-2)}
.vs-c--hi .vs-r span{color:rgba(255,255,255,.64)}
.vs-band{margin-top:22px;padding:26px 30px;background:#000;color:#fff;border-radius:16px;text-align:center;font-size:1rem;line-height:1.55}
.vs-band em{font-style:normal;color:rgba(255,255,255,.58)}

/* ==========================================================================
   11 · SECUENCIA OPERATIVA
   ========================================================================== */
.flow{position:relative;margin-top:48px}
.flow-line{position:absolute;top:7px;left:0;right:0;height:1px;background:var(--line-mid)}
.flow-line i{position:absolute;left:0;top:0;height:100%;width:0;background:#000;display:block;transition:width .25s linear}
.flow-g{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
.flow-s{padding-top:32px;position:relative;opacity:.42;transition:opacity .5s var(--ease)}
.flow-s.on{opacity:1}
.flow-s::before{
  content:'';position:absolute;top:2px;left:0;width:11px;height:11px;border-radius:50%;
  background:#fff;border:1.5px solid var(--line-mid);
  transition:background .45s var(--ease),border-color .45s var(--ease),transform .45s var(--ease);
}
.flow-s.on::before{background:#000;border-color:#000;transform:scale(1.2)}
.flow-t{font-family:var(--mono);font-size:.64rem;color:var(--tx-2);letter-spacing:.11em;margin-bottom:7px}
.flow-n{font-family:var(--mono);font-size:1.7rem;font-weight:700;letter-spacing:-.05em;margin-bottom:9px}
.flow-s h4{font-size:.94rem;font-weight:600;margin-bottom:7px}
.flow-s p{font-size:.8rem;color:var(--tx-2);line-height:1.5}

/* ==========================================================================
   12 · CARRUSEL
   ========================================================================== */
