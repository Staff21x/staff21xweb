/* ==========================================================================
   L · Consola de respaldo
   Muestra el servicio trabajando: la superficie se descubre, el hallazgo se
   valida, la acción se firma y el expediente se completa solo. Es la prueba
   visual del respaldo que promete el titular.
   ========================================================================== */
(function(){
  var panel = document.getElementById('cons');
  var box   = document.getElementById('cons-lines');
  if (!panel || !box) return;

  var EVENTOS = [
    ['SUPERFICIE',   'api-pagos-v3 publicada · alcance ampliado'],
    ['OFENSIVO',     'explotabilidad descartada en 3 endpoints'],
    ['DARK WEB',     'credencial corporativa expuesta · rotada'],
    ['IDENTIDAD',    'token con privilegios elevados revocado'],
    ['TERCEROS',     'pasarela degradada · origen atribuido'],
    ['FIRMA',        'contención autorizada por ingeniero L3'],
    ['CUMPLIMIENTO', 'control mapeado a marco local'],
    ['OFENSIVO',     'vector confirmado · prioridad elevada'],
    ['SUPERFICIE',   'activo no declarado incorporado al parque'],
    ['FIRMA',        'aislamiento rechazado · impacto en producción']
  ];

  var chks  = panel.querySelectorAll('.cons-chk');
  var ready = panel.querySelector('.cons-ready');
  var i = 0, visible = false, tick = 0;

  new IntersectionObserver(function(en){ visible = en[0].isIntersecting; },
    { threshold: .15 }).observe(panel);

  function linea(){
    var e = EVENTOS[i % EVENTOS.length];
    i++;
    var d = document.createElement('div');
    d.className = 'cons-ln';
    d.innerHTML = '<b>' + e[0] + '</b><span>' + e[1] + '</span>';
    box.insertBefore(d, box.firstChild);
    while (box.children.length > 6) box.removeChild(box.lastChild);
    Array.prototype.forEach.call(box.children, function(el, k){
      el.classList.toggle('mute', k > 0);
    });
  }

  for (var k = 0; k < 6; k++) linea();

  setInterval(function(){
    if (!visible || reduce) return;
    linea();
    tick++;
    // el expediente se completa a medida que la operación avanza
    var paso = tick % 7;
    if (paso === 0){
      chks.forEach(function(c){ c.classList.remove('on'); });
      if (ready) ready.classList.remove('on');
    } else if (paso <= chks.length){
      chks[paso - 1].classList.add('on');
      if (paso === chks.length && ready) ready.classList.add('on');
    }
  }, 2100);
})();


