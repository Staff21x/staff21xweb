/* ==========================================================================
   H · Escena fijada de las tres capas
   ========================================================================== */
var pin = document.getElementById('pin');
var panes = document.querySelectorAll('#panes .pin-pane');
var layers = document.querySelectorAll('#stack .layer');
var pinFill = document.getElementById('pin-fill');
var pinIdx = -1;

function updatePin(){
  if (!pin || window.innerWidth <= 960 || reduce) return;
  var r = pin.getBoundingClientRect();
  var span = pin.offsetHeight - window.innerHeight;
  if (span <= 0) return;
  var p = Math.min(Math.max((-r.top) / span, 0), 1);
  if (pinFill) pinFill.style.width = (p * 100) + '%';
  var i = Math.min(Math.floor(p * panes.length), panes.length - 1);
  if (i !== pinIdx){
    setPinIdx(i);
  }
}

function setPinIdx(i) {
    pinIdx = i;
    panes.forEach(function(s, k){ s.classList.toggle('on', k === i); });
    layers.forEach(function(l, k){ l.classList.toggle('on', k === i); });
}

// Interacción manual
layers.forEach(function(l, i) {
    l.addEventListener('click', function() {
        if (!pin || window.innerWidth <= 960 || reduce) return;
        var span = pin.offsetHeight - window.innerHeight;
        var targetP = (i + 0.1) / panes.length; // Posicionarse un poco dentro de la sección
        var targetY = pin.offsetTop + (span * targetP);
        window.scrollTo({ top: targetY, behavior: 'smooth' });
        setPinIdx(i);
    });
});

/* ==========================================================================
   I · Secuencia operativa con línea de avance
   ========================================================================== */
var flows = Array.prototype.slice.call(document.querySelectorAll('.flow')).map(function(f){
  return { el:f, fill:f.querySelector('.flow-line i'), steps:f.querySelectorAll('.flow-s') };
});

function updateFlow(){
  var vh = window.innerHeight;
  flows.forEach(function(f){
    var r = f.el.getBoundingClientRect();
    if (r.bottom < -100 || r.top > vh + 100) return;
    var a = vh * .86, b = vh * .28;
    var p = Math.min(Math.max((a - r.top) / (a - b), 0), 1);
    if (f.fill) f.fill.style.width = (p * 100) + '%';
    f.steps.forEach(function(s, i){ s.classList.toggle('on', p >= i / f.steps.length + .015); });
  });
}

/* Marcos normativos: cada línea aparece a su turno mientras se recorre la lista */
var fwRows = document.querySelectorAll('.fw');
function updateFws(){
  if (!fwRows.length) return;
  var vh = window.innerHeight;
  fwRows.forEach(function(row){
    if (row.classList.contains('on')) return;
    var r = row.getBoundingClientRect();
    if (r.top < vh * .90 && r.bottom > 0) row.classList.add('on');
  });
}

/* Campos del reporte: entran uno tras otro */
document.querySelectorAll('.tags').forEach(function(box){
