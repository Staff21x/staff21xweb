<script>
(function(){
'use strict';
var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ==========================================================================
   A · Revelado de titulares palabra por palabra
   ========================================================================== */
function splitInto(el){
  if (el.dataset.split) return;
  el.dataset.split = '1';
  var frag = document.createDocumentFragment();
  var nodes = Array.prototype.slice.call(el.childNodes);

  nodes.forEach(function(node){
    if (node.nodeType === 3){
      var parts = node.textContent.replace(/\u00A0/g, ' ').split(' ');
      for (var pi = 0; pi < parts.length; pi++){
        if (parts[pi] === ''){ continue; }
        var w = document.createElement('span'); w.className = 'w';
        var ii = document.createElement('i'); ii.textContent = parts[pi];
        w.appendChild(ii); frag.appendChild(w);
        if (pi < parts.length - 1){
          var sp = document.createElement('span');
          sp.className = 'sp'; sp.textContent = ' ';
          frag.appendChild(sp);
        }
      }
    } else if (node.nodeType === 1){
      if (node.tagName === 'BR'){ frag.appendChild(node.cloneNode()); return; }
      // Se añade tal cual, sin envolverlo: encerrarlo en un bloque lo volvería
      // indivisible y en pantallas angostas desbordaría o partiría mal.
      var el2 = node.cloneNode(true);
      el2.classList.add('wx');
      frag.appendChild(el2);
    }
  });

  el.innerHTML = '';
  el.appendChild(frag);

  var ws = el.querySelectorAll('.w > i');
  Array.prototype.forEach.call(ws, function(w, k){
    w.style.transitionDelay = Math.min(k * 0.032, 0.7) + 's';
  });
}
document.querySelectorAll('.split').forEach(splitInto);

/* ==========================================================================
   B · Observador único: aparición, barrido de imagen, resaltado, contadores
   ========================================================================== */
var io = new IntersectionObserver(function(entries){
  entries.forEach(function(en){
    if (!en.isIntersecting) return;
    var el = en.target;
    el.classList.add('is-in');
    if (el.classList.contains('tags')) el.classList.add('on');

    if (el.classList.contains('split')){
      var total = el.querySelectorAll('.w').length * 32 + 900;
      setTimeout(function(){ el.classList.add('is-done'); }, total);
    }

    var hls = el.classList.contains('hl') ? [el] : el.querySelectorAll('.hl');
    Array.prototype.forEach.call(hls, function(h, k){
      setTimeout(function(){ h.classList.add('lit'); }, 420 + k * 150);
    });

    Array.prototype.forEach.call(el.querySelectorAll('[data-count]'), countUp);
    if (el.hasAttribute('data-count')) countUp(el);

    io.unobserve(el);
  });
}, { threshold: .16, rootMargin: '0px 0px -6% 0px' });

document.querySelectorAll('.up, .seq, .split, .shot, .bits, .tags').forEach(function(el){ io.observe(el); });
document.querySelectorAll('.hl').forEach(function(h){
  if (!h.closest('.up, .seq, .split')) io.observe(h);
});
document.querySelectorAll('[data-count]').forEach(function(c){
  if (!c.closest('.up, .seq')) io.observe(c);
});

function countUp(el){
  if (el.dataset.counted) return;
  el.dataset.counted = '1';
  var target = parseInt(el.dataset.count, 10);
  if (isNaN(target)) return;
  if (reduce){ el.textContent = target.toLocaleString('es-CL'); return; }
  var dur = 1200, t0 = null;
  el.textContent = '0';
  requestAnimationFrame(function step(ts){
    if (!t0) t0 = ts;
    var p = Math.min((ts - t0) / dur, 1);
    var e = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.round(target * e).toLocaleString('es-CL');
    if (p < 1) requestAnimationFrame(step);
  });
}

/* ==========================================================================
   C · Disgregación en bits
   Cada captura marcada con .px se dibuja en un lienzo troceado en celdas
   cuadradas. La posición de scroll decide cuánto están dispersas: entran
   armándose y se deshacen al salir por arriba. Se aplica solo a tres
   momentos del recorrido, no a todo el documento.
   ========================================================================== */
var pixelUnits = [];

function initPixel(frame){
  var img = frame.querySelector('img');
  if (!img) return;

  var holder = document.createElement('div');
  holder.className = 'px-holder';
  img.parentNode.insertBefore(holder, img);
  holder.appendChild(img);

  var cv = document.createElement('canvas');
  cv.className = 'px-canvas';
  cv.setAttribute('aria-hidden', 'true');
  holder.appendChild(cv);

  var ctx = cv.getContext('2d');
  if (!ctx){ holder.classList.add('px-off'); return; }

  var unit = {
    frame: frame, holder: holder, img: img, cv: cv, ctx: ctx,
    cols: 0, rows: 0, cw: 0, ch: 0, w: 0, hgt: 0,
    ang: null, dist: null, delay: null,
    last: -1, ready: false
  };

  function build(){
    var rect = holder.getBoundingClientRect();
    if (rect.width < 10 || !img.naturalWidth) return;

    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    unit.w = rect.width;
    unit.hgt = rect.height;
    cv.width  = Math.round(rect.width * dpr);
    cv.height = Math.round(rect.height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // celdas de ~15 px en pantalla; menos celdas en móvil
    var target = rect.width < 620 ? 22 : 15;
    unit.cols = Math.max(8, Math.round(rect.width / target));
    unit.rows = Math.max(6, Math.round(rect.height / target));
    unit.cw = rect.width / unit.cols;
    unit.ch = rect.height / unit.rows;

    var total = unit.cols * unit.rows;
    unit.ang   = new Float32Array(total);
    unit.dist  = new Float32Array(total);
    unit.delay = new Float32Array(total);

    for (var i = 0; i < total; i++){
      unit.ang[i]   = Math.random() * Math.PI * 2;
      unit.dist[i]  = 26 + Math.random() * 130;
      // las celdas de abajo se van primero: la imagen se deshace hacia arriba
      var row = Math.floor(i / unit.cols);
      unit.delay[i] = Math.min(.72, (1 - row / unit.rows) * .34 + Math.random() * .38);
    }

    unit.ready = true;
    unit.last = -1;
  }

  function draw(s){
    if (!unit.ready) return;
    ctx.clearRect(0, 0, unit.w, unit.hgt);

    var iw = img.naturalWidth, ih = img.naturalHeight;
    var sx = iw / unit.cols, sy = ih / unit.rows;

    for (var r = 0; r < unit.rows; r++){
      for (var c = 0; c < unit.cols; c++){
        var i = r * unit.cols + c;
        var dl = unit.delay[i];
        var d = (s - dl) / (1 - dl);
        if (d < 0) d = 0; else if (d > 1) d = 1;

        if (d > .985) continue;                 // celda ya desintegrada
        var e = d * d;                          // arranque suave

        var ox = Math.cos(unit.ang[i]) * unit.dist[i] * e;
        var oy = Math.sin(unit.ang[i]) * unit.dist[i] * e - e * 26;
        var k  = 1 - e * .55;

        ctx.globalAlpha = 1 - d;
        ctx.drawImage(
          img,
          c * sx, r * sy, sx, sy,
          c * unit.cw + ox + (unit.cw * (1 - k)) / 2,
          r * unit.ch + oy + (unit.ch * (1 - k)) / 2,
          unit.cw * k + .6, unit.ch * k + .6
        );
      }
    }
    ctx.globalAlpha = 1;
  }

  unit.build = build;
  unit.draw = draw;

  function ready(){
    build();
    unit.last = -1;
    updatePixels();
  }
  if (img.complete && img.naturalWidth) ready();
  else img.addEventListener('load', ready);

  window.addEventListener('resize', function(){ build(); unit.last = -1; updatePixels(); });

  pixelUnits.push(unit);
}

function updatePixels(){
  var vh = window.innerHeight;
  for (var i = 0; i < pixelUnits.length; i++){
    var u = pixelUnits[i];
    if (!u.ready) continue;

    var r = u.frame.getBoundingClientRect();
    if (r.bottom < -220 || r.top > vh + 220) continue;   // fuera de alcance

    // se arma mientras entra
    var pIn = (vh * .94 - r.top) / (vh * .5);
    if (pIn < 0) pIn = 0; else if (pIn > 1) pIn = 1;

    // se deshace mientras sale por arriba
    var pOut = (vh * .12 - r.bottom) / (vh * .42);
    if (pOut < 0) pOut = 0; else if (pOut > 1) pOut = 1;

    var s = Math.max(1 - pIn, pOut);
    if (Math.abs(s - u.last) < .004) continue;
    u.last = s;
    u.draw(s);
  }
}

if (!reduce){
  document.querySelectorAll('.frame.px').forEach(initPixel);
} else {
  document.querySelectorAll('.frame.px img').forEach(function(im){ im.style.opacity = 1; });
}

/* ==========================================================================
   D · Titulares que se materializan carácter a carácter
   ========================================================================== */
document.querySelectorAll('.bits').forEach(function(el){
  if (reduce) return;

  // El efecto va por carácter en todas las pantallas. Lo que impide que una
  // palabra se parta no es renunciar a la animación, sino que cada palabra
  // sea una unidad cerrada con las letras animándose dentro.
  var narrow = window.innerWidth < 760;
  var spread = narrow ? 22 : 42;   // en un teléfono la dispersión es más corta
  var base   = narrow ? 10 : 16;

  var txt = el.textContent.replace(/\u00A0/g, ' ').trim();
  var words = txt.split(' ');
  el.textContent = '';
  var k = 0;

  for (var wi = 0; wi < words.length; wi++){
    var token = words[wi];
    if (token === '') continue;

    // La palabra es la unidad indivisible; las letras se animan dentro.
    var word = document.createElement('span');
    word.className = 'wd';

    for (var i = 0; i < token.length; i++){
      var s = document.createElement('span');
      s.className = 'ch';
      s.textContent = token.charAt(i);
      var a = Math.random() * Math.PI * 2;
      var d = base + Math.random() * spread;
      s.style.setProperty('--dx', (Math.cos(a) * d).toFixed(1) + 'px');
      s.style.setProperty('--dy', (Math.sin(a) * d).toFixed(1) + 'px');
      s.style.setProperty('--d', (k * 0.012 + Math.random() * 0.15).toFixed(3) + 's');
      word.appendChild(s);
      k++;
    }
    el.appendChild(word);

    // Separador propio: no se apoya en un nodo de texto suelto, que es
    // frágil entre elementos de bloque en línea.
    if (wi < words.length - 1){
      var sp = document.createElement('span');
      sp.className = 'sp';
      sp.textContent = ' ';
      el.appendChild(sp);
    }
  }
});

