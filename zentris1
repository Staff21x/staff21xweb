/* ==========================================================================
   J · Carrusel de capturas
   ========================================================================== */
var tr = document.getElementById('car-tr');
if (tr){
  var slides = tr.children, n = slides.length, idx = 0;
  var prev = document.getElementById('car-prev');
  var next = document.getElementById('car-next');
  var dotsBox = document.getElementById('car-dots');
  var txBox = document.getElementById('car-tx');
  var counter = document.getElementById('car-count');

  var META = [
    ['Dashboard', 'Postura del parque, aprobaciones pendientes, casos críticos y eventos procesados, en una sola vista.'],
    ['Detección y triaje', 'Veredicto explícito por evento: verdadero positivo, en revisión o falso positivo, con su nivel de confianza y la regla que lo produjo.'],
    ['Aprobaciones', 'La cola del punto de control: acción propuesta, caso asociado, estado y el experto que la resuelve.'],
    ['Cumplimiento', 'Score por marco normativo, controles cubiertos y parciales, y tendencia diaria sobre datos reales.'],
    ['Reportería', 'El informe del SOC generado sobre la operación, listo para exportar o enviar por correo.']
  ];

  for (var d = 0; d < n; d++){
    (function(k){
      var b = document.createElement('button');
      b.setAttribute('aria-label', 'Ir a la captura ' + (k + 1));
      b.addEventListener('click', function(){ go(k); });
      dotsBox.appendChild(b);
    })(d);
  }
  var dots = dotsBox.children;

  function go(k){
    idx = Math.min(Math.max(k, 0), n - 1);
    tr.style.transform = 'translateX(' + (-idx * 100) + '%)';
    for (var i = 0; i < n; i++){
      dots[i].classList.toggle('on', i === idx);
      slides[i].classList.toggle('on', i === idx);
    }
    prev.disabled = idx === 0;
    next.disabled = idx === n - 1;
    txBox.innerHTML = '<h4>' + META[idx][0] + '</h4><p>' + META[idx][1] + '</p>';
    counter.textContent = ('0' + (idx + 1)).slice(-2) + ' / ' + ('0' + n).slice(-2);
    fitHeight();
  }

  // El visor se ajusta a la lámina activa: cada captura tiene su propia
  // proporción y sin esto todas heredarían la altura de la más alta.
  var vp = document.querySelector('.car-vp');
  function fitHeight(){
    if (!vp || !slides[idx]) return;
    var hh = slides[idx].offsetHeight;
    if (hh > 0) vp.style.height = hh + 'px';
  }
  window.addEventListener('resize', fitHeight);
  window.addEventListener('load', fitHeight);
  Array.prototype.forEach.call(tr.querySelectorAll('img'), function(im){
    if (im.complete) return;
    im.addEventListener('load', fitHeight);
  });

  prev.addEventListener('click', function(){ go(idx - 1); });
  next.addEventListener('click', function(){ go(idx + 1); });

  var x0 = null;
  tr.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, {passive:true});
  tr.addEventListener('touchend', function(e){
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 45) go(idx + (dx < 0 ? 1 : -1));
    x0 = null;
  });
  document.getElementById('car').addEventListener('keydown', function(e){
    if (e.key === 'ArrowRight'){ e.preventDefault(); go(idx + 1); }
    if (e.key === 'ArrowLeft'){ e.preventDefault(); go(idx - 1); }
  });
  go(0);
}

/* ==========================================================================
   K · Un solo ciclo por cuadro
   ========================================================================== */
var ticking = false;
function onScroll(){
  if (ticking) return;
  ticking = true;
  requestAnimationFrame(function(){
    updateProgress();
    updateHeader();
    updateNav();
    updatePin();
    updateFlow();
    updateFws();
    updatePixels();
    ticking = false;
  });
}
window.addEventListener('scroll', onScroll, {passive:true});
window.addEventListener('resize', onScroll);
onScroll();

